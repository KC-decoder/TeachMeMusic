{
  "name": "teachmemusic-web",
  "version": "0.0.0",
  "private": true,
  "description": "Browser adapters and UI for TeachMeMusic canonical viewer bundles.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
