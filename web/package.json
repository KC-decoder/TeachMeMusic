    "test:app-piano-guidance-proof": "node proofs/app-piano-guidance-proof.mjs",
    "test:app-playback-proof": "node proofs/app-playback-proof.mjs",
    "test:app-teaching-loop-proof": "node proofs/app-teaching-loop-proof.mjs",
    "test:app-teaching-proof": "node proofs/app-teaching-proof.mjs",
