# Virtual environments
.venv/
venv/

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Test and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Build and distribution artifacts
build/
dist/
*.egg-info/
.eggs/

# Editors and IDEs
.idea/
.vscode/
*.swp
*.swo

# Operating system
.DS_Store
Thumbs.db

# Qwen Code session state (machine-specific, not project content)
.qwen/

# Application output (keep the directory itself via outputs/.gitkeep)
outputs/*
!outputs/.gitkeep
